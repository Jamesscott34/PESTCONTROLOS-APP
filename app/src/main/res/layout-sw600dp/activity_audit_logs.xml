<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/audit_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/auditToday"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minHeight="56dp"
            android:text="@string/audit_today"
            android:textSize="14sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/auditSeven"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:layout_marginEnd="4dp"
            android:minHeight="56dp"
            android:text="@string/audit_seven_days"
            android:textSize="14sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/auditAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="56dp"
            android:text="@string/audit_all"
            android:textSize="14sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>

    <Button
        android:id="@+id/auditDeleteAll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="56dp"
        android:text="@string/audit_delete_all"
        android:textSize="16sp"
        android:backgroundTint="?attr/colorError"
        android:textColor="?attr/colorOnError" />

    <Spinner
        android:id="@+id/auditUserFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="48dp" />

    <Spinner
        android:id="@+id/auditActivityFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="48dp" />

    <TextView
        android:id="@+id/auditEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/audit_empty"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary" />

    <ListView
        android:id="@+id/auditList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp"
        android:scrollbars="vertical"
        android:fadeScrollbars="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/auditSavePdf"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:minHeight="56dp"
            android:text="@string/audit_save_pdf"
            android:textSize="16sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/auditSaveExcel"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="6dp"
            android:minHeight="56dp"
            android:text="@string/audit_save_excel"
            android:textSize="16sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>
</LinearLayout>
