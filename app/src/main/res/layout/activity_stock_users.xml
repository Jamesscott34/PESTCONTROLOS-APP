<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stock_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/stock_users_title"
        android:textSize="16sp"
        android:textColor="?android:attr/textColorSecondary" />

    <Button
        android:id="@+id/buttonRequestStock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:text="@string/stock_request_stock"
        android:background="@drawable/button_background"
        android:textColor="?attr/colorOnPrimary" />

    <Button
        android:id="@+id/buttonAllPending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:minHeight="56dp"
        android:text="@string/stock_all_pending"
        android:background="@drawable/button_background"
        android:textColor="?attr/colorOnPrimary" />

    <TextView
        android:id="@+id/stockUsersEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/stock_no_users"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary" />

    <ListView
        android:id="@+id/stockUsersList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />
</LinearLayout>
