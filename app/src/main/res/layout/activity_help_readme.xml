                <TextView android:id="@+id/section6Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_6" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
