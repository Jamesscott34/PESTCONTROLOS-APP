                <TextView android:id="@+id/section17Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_17" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section17Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section17" />
            </LinearLayout>

            <!-- Section 18: Super Admin / Owner only -->
            <LinearLayout
                android:id="@+id/sectionOwner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/sectionOwnerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/help_header_owner"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:padding="10dp"
                    android:background="?attr/colorSurface"
                    android:textColor="?android:attr/textColorPrimary" />

                <TextView
                    android:id="@+id/sectionOwnerContent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:padding="10dp"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:text="@string/help_section_owner" />
