            </LinearLayout>

            <!-- Section 10 -->
            <LinearLayout android:id="@+id/section10" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section10Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_10" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
