<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingTop="?attr/actionBarSize"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <View
        android:layout_width="match_parent"
        android:layout_height="24dp" />

    <TextView
        android:id="@+id/helpTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/help_title"
        android:textSize="20sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="8dp"
        android:textColor="?android:attr/textColorPrimary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/help_intro_hint"
        android:textSize="13sp"
        android:gravity="center"
        android:layout_marginBottom="12dp"
        android:textColor="?android:attr/textColorSecondary" />

    <!-- Super Admin: preview help text for other roles -->
    <LinearLayout
        android:id="@+id/helpRoleRow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="12dp"
        android:visibility="gone">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/help_view_for_label"
            android:textColor="?android:attr/textColorSecondary"
            android:layout_marginEnd="8dp" />

        <Spinner
            android:id="@+id/helpRoleSpinner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/edit_text_border"
            android:padding="8dp"
            android:spinnerMode="dropdown" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <LinearLayout
            android:id="@+id/helpSectionsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/help_toc"
                android:textSize="13sp"
                android:padding="10dp"
                android:layout_marginBottom="12dp"
                android:background="?attr/colorSurface"
                android:textColor="?android:attr/textColorSecondary" />

            <!-- Section 1 -->
            <LinearLayout android:id="@+id/section1" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section1Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_1" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section1Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section1" />
            </LinearLayout>

            <!-- Section 2 -->
            <LinearLayout android:id="@+id/section2" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section2Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_2" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section2Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section2" />
            </LinearLayout>

            <!-- Section 3 -->
            <LinearLayout android:id="@+id/section3" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section3Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_3" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section3Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section3" />
            </LinearLayout>

            <!-- Section 4 -->
            <LinearLayout android:id="@+id/section4" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
