            </LinearLayout>

            <!-- Section 12 -->
            <LinearLayout android:id="@+id/section12" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section12Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_12" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section12Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section12" />
            </LinearLayout>

            <!-- Section 13 -->
            <LinearLayout android:id="@+id/section13" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section13Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_13" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section13Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section13" />
            </LinearLayout>

            <!-- Section 14 -->
            <LinearLayout android:id="@+id/section14" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section14Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_14" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section14Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section14" />
            </LinearLayout>

            <!-- Section 15 -->
            <LinearLayout android:id="@+id/section15" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section15Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_15" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
                <TextView android:id="@+id/section15Content" android:layout_width="match_parent" android:layout_height="wrap_content" android:visibility="gone" android:padding="10dp" android:textSize="14sp" android:lineSpacingExtra="2dp" android:textColor="?android:attr/textColorPrimary" android:text="@string/help_section15" />
