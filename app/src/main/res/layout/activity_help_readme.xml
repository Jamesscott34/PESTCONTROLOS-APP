            </LinearLayout>

            <!-- Section 11 -->
            <LinearLayout android:id="@+id/section11" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginBottom="8dp">
                <TextView android:id="@+id/section11Header" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/help_header_11" android:textSize="16sp" android:textStyle="bold" android:padding="10dp" android:background="?attr/colorSurface" android:textColor="?android:attr/textColorPrimary" />
