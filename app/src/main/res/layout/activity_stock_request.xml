<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="?android:attr/colorBackground"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/stock_request_title"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="?android:attr/textColorPrimary" />

        <AutoCompleteTextView
            android:id="@+id/stockProductInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="48dp"
            android:hint="@string/stock_product_hint"
            android:inputType="text"
            android:completionThreshold="1" />

        <EditText
            android:id="@+id/stockQuantityInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:hint="@string/stock_quantity_hint"
            android:inputType="textCapSentences"
            android:importantForAutofill="no" />

        <Button
            android:id="@+id/buttonAddStockItem"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:minHeight="48dp"
            android:text="@string/stock_add_item"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <LinearLayout
            android:id="@+id/stockItemsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="vertical" />

        <EditText
            android:id="@+id/stockNotesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:minHeight="80dp"
            android:gravity="top"
            android:hint="@string/stock_notes_hint"
            android:inputType="textMultiLine|textCapSentences" />

        <Button
            android:id="@+id/buttonSubmitStockRequest"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:minHeight="56dp"
            android:text="@string/stock_submit"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>
</ScrollView>
