<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="?android:attr/colorBackground">

    <TextView
        android:id="@+id/stockHistoryTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/stock_history_title"
        android:textSize="22sp"
        android:textStyle="bold"
        android:textColor="?android:attr/textColorPrimary" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonFilterPending"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minHeight="48dp"
            android:text="@string/stock_filter_pending"
            android:textSize="12sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/buttonFilterReady"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="48dp"
            android:text="@string/stock_filter_ready"
            android:textSize="12sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/buttonFilterRetrieved"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:minHeight="48dp"
            android:text="@string/stock_filter_retrieved"
            android:textSize="12sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />

        <Button
            android:id="@+id/buttonFilterAll"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:minHeight="48dp"
            android:text="@string/stock_filter_all"
            android:textSize="12sp"
            android:background="@drawable/button_background"
            android:textColor="?attr/colorOnPrimary" />
    </LinearLayout>

    <TextView
        android:id="@+id/stockHistoryEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/stock_no_requests"
        android:visibility="gone"
        android:textColor="?android:attr/textColorSecondary" />

    <ListView
        android:id="@+id/stockHistoryList"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:divider="@android:color/transparent"
        android:dividerHeight="8dp" />
</LinearLayout>
